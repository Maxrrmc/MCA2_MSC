import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import quad

# 1. Definición de las funciones
f1 = lambda x: 8 * np.cos(x)
f2 = lambda x: 1 / (np.cos(x)**2)  # sec^2(x)

# 2. Intervalo
a, b = -np.pi/3, np.pi/3
x = np.linspace(a, b, 400)

# 3. Graficación
plt.figure(figsize=(10, 6))

# Usamos 'r' en los labels para evitar el SyntaxWarning
plt.plot(x, f1(x), label=r'$y = 8 \cos(x)$', color='blue', linewidth=2)
plt.plot(x, f2(x), label=r'$y = \sec^2(x)$', color='red', linewidth=2)

# Rellenar el área entre las curvas
plt.fill_between(x, f1(x), f2(x), color='gray', alpha=0.3, label='Área de la región')

# 4. Configuración estética (Consolidada con 'r')
plt.title(r'Región entre $y = 8 \cos(x)$ y $y = \sec^2(x)$')
plt.xlabel(r'$x$')
plt.ylabel(r'$y$')
plt.xticks([-np.pi/3, 0, np.pi/3], [r'$-\pi/3$', r'$0$', r'$\pi/3$'])
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.show()

# 5. Cálculo del área
area, error = quad(lambda x: f1(x) - f2(x), a, b)
print(f"El área calculada es: {area:.4f} unidades cuadradas.")
print(f"El valor exacto es 6√3 ≈ {6 * np.sqrt(3):.4f}")
