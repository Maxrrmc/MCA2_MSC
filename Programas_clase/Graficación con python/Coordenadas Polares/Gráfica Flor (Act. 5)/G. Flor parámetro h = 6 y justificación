import numpy as np
import matplotlib.pyplot as plt

h = 6

theta = np.linspace(0, 2 * np.pi, 4000)
r = 3 * np.cos(2 * theta)
x = r * np.sin(theta)
y = r * np.cos(theta)

plt.title('Gráfica Flor; parámetro h = 6') 
plt.axis('off');
plt.axis('equal');
plt.plot(x, y, color='red'); 

plt.show()

