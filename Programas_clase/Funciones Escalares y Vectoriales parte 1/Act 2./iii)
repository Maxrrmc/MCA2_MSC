import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

# Configurar el estilo visual
plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')
fig = plt.figure(figsize=(10, 8))
ax = fig.add_subplot(111, projection='3d')

# Parámetros de la forma canónica: x^2/a^2 + y^2/b^2 - z^2/c^2 = 1
a = np.sqrt(2)
b = 2/3
c = 1

# Definir las variables paramétricas (u para la altura z, v para el ángulo angular)
u = np.linspace(-2, 2, 100) # Rango para el eje Z
v = np.linspace(0, 2 * np.pi, 100)
U, V = np.meshgrid(u, v)

# Ecuaciones paramétricas del hiperboloide de una hoja
X = a * np.cosh(U) * np.cos(V)
Y = b * np.cosh(U) * np.sin(V)
Z = c * U

# Graficar la superficie con un mapa de color estético
surf = ax.plot_surface(X, Y, Z, cmap='coolwarm', edgecolor='none', alpha=0.85)

# Configuración de etiquetas y diseño
ax.set_xlabel('Eje X', fontsize=11, labelpad=10)
ax.set_ylabel('Eje Y', fontsize=11, labelpad=10)
ax.set_zlabel('Eje Z', fontsize=11, labelpad=10)
ax.set_title(r'Hiperboloide de una hoja: $2x^2 + 9y^2 - 4z^2 = 4$', fontsize=14, pad=20, fontweight='bold')

# Ajustar límites para mantener una proporción visual adecuada
max_range = np.array([X.max()-X.min(), Y.max()-Y.min(), Z.max()-Z.min()]).max() / 2.0
mid_x = (X.max()+X.min()) * 0.5
mid_y = (Y.max()+Y.min()) * 0.5
mid_z = (Z.max()+Z.min()) * 0.5
ax.set_xlim(mid_x - max_range, mid_x + max_range)
ax.set_ylim(mid_y - max_range, mid_y + max_range)
ax.set_zlim(mid_z - max_range, mid_z + max_range)

# Añadir barra de color integrada
fig.colorbar(surf, ax=ax, shrink=0.5, aspect=10, pad=0.1)

# Mostrar vista en perspectiva idónea
ax.view_init(elev=20, azim=45)

plt.show()
