import numpy as np
import matplotlib.pyplot as plt

# Crear una malla de puntos en el plano X, Y alrededor del vértice
x_vals = np.linspace(-4, 2, 100)
y_vals = np.linspace(-1, 4, 100)
X, Y = np.meshgrid(x_vals, y_vals)

# Calcular los valores de Z usando la función original
Z = X**2 + 3*Y**2 + 2*X - 9*Y

# Configurar la gráfica tridimensional
fig = plt.figure(figsize=(8, 6))
ax = fig.add_subplot(111, projection='3d')

# Dibujar la superficie del paraboloide elíptico
superficie = ax.plot_surface(X, Y, Z, cmap='plasma', alpha=0.8, edgecolor='none')

# Marcar el punto del vértice (el mínimo)
ax.scatter([-1], [1.5], [-7.75], color='cyan', s=100, label='Vértice (-1, 1.5, -7.75)')

# Etiquetas de los ejes
ax.set_xlabel('Eje X')
ax.set_ylabel('Eje Y')
ax.set_zlabel('Eje Z (f(x,y))')
ax.set_title('Gráfica del Paraboloide Elíptico')
ax.legend()

# Mostrar la visualización
plt.show()
